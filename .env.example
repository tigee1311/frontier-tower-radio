# Copy to .env and fill in:  cp .env.example .env
#
# `npm run server` (and `npm start`) load .env automatically via Node's
# --env-file-if-exists, so no dotenv package is needed. In Docker/Render the
# platform supplies these as real environment variables instead.
#
# Every variable here is optional — the server boots without any of them, with
# the degraded behaviour noted below.

# Port the API + WebSocket server listens on. Default: 3001.
# The React dev server proxies to localhost:3001, so change both if you change this.
PORT=3001

# Set to "production" to make the server also serve the built React app from
# ./build and handle SPA routing. Leave unset for local development.
# NODE_ENV=production

# PIN for the admin panel (the small "A" button, bottom-right).
# Default: 1311 — override this in any deployment.
ADMIN_PIN=1311

# Stripe secret key. Enables the $1 "paid skip" Checkout flow.
# Without it, POST /api/skip/checkout returns 500 {"error":"Payments not configured"}.
# STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret for POST /api/skip/webhook.
# If unset, the webhook body is parsed WITHOUT signature verification — set this
# in production or anyone can forge a skip.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Netscape-format YouTube cookies, written to ./cookies.txt at boot and passed to
# yt-dlp by the /api/stream/:videoId fallback. Only needed when YouTube
# rate-limits your server's IP (common on cloud hosts).
# YT_COOKIES=
